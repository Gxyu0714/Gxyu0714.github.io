<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% assign enable_scroll = false %}
    {% if include.limit and site.announcements.scrollable and news_size > 3 %}
      {% assign enable_scroll = true %}
    {% endif %}

    <div class="news-scroll{% if enable_scroll %} news-scroll--fade{% endif %}">
      <div class="news-scroll__inner">
        <table class="table table-sm table-borderless">
          {% for item in news limit: news_limit %}
            <tr>
              <th scope="row" class="news-date">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">
                    <span class="lang-en">{{ item.title }}</span>
                    <span class="lang-zh">{{ item.title_zh | default: item.title }}</span>
                  </a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
    </div>
  {% else %}
    <p>
      <span class="lang-en">{{ site.data.i18n.en.no_news }}</span>
      <span class="lang-zh">{{ site.data.i18n.zh.no_news }}</span>
    </p>
  {% endif %}
</div>
